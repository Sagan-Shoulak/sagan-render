module main

import open from render.ui
import poll from render.ui
import close from render.ui
import width from render.ui
import height from render.ui
import begin from render.ui
import fill from render.ui
import text from render.ui
import present from render.ui
import key_pressed from render.ui
import pointer_pressed from render.ui
import pointer_x from render.ui
import pointer_y from render.ui
import elapsed_seconds from render.ui
import SpatialRenderable from render.scene
import RenderSample from render.scene
import sample from render.scene
import relative_axis from render.scene
import perspective_axis from render.scene
import depth_visible from render.scene
import SelectionState from render.scene
import smooth_focus_axis from render.scene
import pick_circle from render.scene
import draw_sphere_impostor from render.bodies

const DISTANT_ORIGIN: Float64<meter> = 1000000000000.0 kilometer
const CAMERA_DEPTH: Float64<meter> = 200000000.0 kilometer
const EARTH_DISTANCE: Float64<meter> = 149597870.7 kilometer
const MOON_DISTANCE: Float64<meter> = 384400.0 kilometer
const SUN_VIEW_DISTANCE: Float64<meter> = 8000000.0 kilometer
const EARTH_VIEW_DISTANCE: Float64<meter> = 90000.0 kilometer
const MOON_VIEW_DISTANCE: Float64<meter> = 30000.0 kilometer

fun wrapped_angle(value: Float64): Float64 {
  let result = value
  while result > 3.141592653589793 { result = result - 6.283185307179586 }
  while result < 0.0 - 3.141592653589793 { result = result + 6.283185307179586 }
  return result
}

/// Demo-only trigonometric approximation. Authoritative orbital state belongs
/// in sagan-physics; the renderer receives only the resulting snapshots.
fun demo_sine(value: Float64): Float64 {
  let angle = wrapped_angle(value)
  let squared = angle * angle
  return angle * (1.0 - squared / 6.0 + squared * squared / 120.0 -
                  squared * squared * squared / 5040.0)
}

fun demo_cosine(value: Float64): Float64 {
  let angle = wrapped_angle(value)
  let squared = angle * angle
  return 1.0 - squared / 2.0 + squared * squared / 24.0 -
         squared * squared * squared / 720.0
}

class PresentationObject has SpatialRenderable {
  let identifier_value: Int64
  let x_value: Float64<meter>
  let y_value: Float64<meter>
  let z_value: Float64<meter>
  let radius_value: Float64<meter>
  let label_value: String

  new(identifier: Int64, x: Float64<meter>, y: Float64<meter>,
      z: Float64<meter>, radius: Float64<meter>, label: String) {
    self.identifier_value = identifier
    self.x_value = x
    self.y_value = y
    self.z_value = z
    self.radius_value = radius
    self.label_value = label
  }

  fun render_identifier(): Int64 => self.identifier_value
  fun render_x(): Float64<meter> => self.x_value
  fun render_y(): Float64<meter> => self.y_value
  fun render_z(): Float64<meter> => self.z_value
  fun render_radius(): Float64<meter> => self.radius_value
  fun render_label(): String => self.label_value
}

fun maximum(first: Float64, second: Float64): Float64 {
  if first > second { return first }
  return second
}

fun moon_marker_offset(camera_z: Float64<meter>, moon: SpatialRenderable): Float64 {
  if camera_z - sample(moon).z() > 10000000.0 kilometer { return 30.0 }
  return 0.0
}

fun draw_object(value: SpatialRenderable,
                camera_x: Float64<meter>, camera_y: Float64<meter>,
                camera_z: Float64<meter>, viewport_x: Float64,
                viewport_y: Float64, viewport_width: Float64,
                viewport_height: Float64, selected: Bool): Void {
  let item: RenderSample = sample(value)
  let forward_depth = camera_z - item.z()
  if depth_visible(forward_depth, item.radius(),
                   1.0 kilometer, 1000000000.0 kilometer) {
    let logical_x = viewport_x + perspective_axis(
      relative_axis(item.x(), camera_x), forward_depth, 0.577350269, viewport_width)
    let logical_y = viewport_y + perspective_axis(
      0.0 meter - relative_axis(item.y(), camera_y), forward_depth,
      0.577350269, viewport_height)
    let minimum_radius = 7.0
    if item.identifier() == 1 { minimum_radius = 22.0 }
    if item.identifier() == 2 { minimum_radius = 18.0 }
    if item.identifier() == 3 {
      logical_x = logical_x + moon_marker_offset(camera_z, value)
    }
    let projected_radius = maximum(minimum_radius,
      (item.radius() / forward_depth) / 0.577350269 * viewport_height / 2.0)
    draw_sphere_impostor(logical_x, logical_y, projected_radius,
                         item.identifier(), selected)
    text(logical_x + projected_radius + 7.0, logical_y - 5.0,
         item.label(), 10.0, 245, 249, 255)
  }
}

fun projected_x(value: SpatialRenderable, camera_x: Float64<meter>,
                camera_z: Float64<meter>,
                viewport_x: Float64, viewport_width: Float64): Float64 {
  let item: RenderSample = sample(value)
  let forward_depth = camera_z - item.z()
  return viewport_x + perspective_axis(
    relative_axis(item.x(), camera_x), forward_depth, 0.577350269, viewport_width)
}

fun projected_y(value: SpatialRenderable, camera_y: Float64<meter>,
                camera_z: Float64<meter>,
                viewport_y: Float64, viewport_height: Float64): Float64 {
  let item: RenderSample = sample(value)
  let forward_depth = camera_z - item.z()
  return viewport_y + perspective_axis(
    0.0 meter - relative_axis(item.y(), camera_y), forward_depth,
    0.577350269, viewport_height)
}

fun selected_target_x(identifier: Int64,
                      first: SpatialRenderable, second: SpatialRenderable,
                      third: SpatialRenderable): Float64<meter> {
  if identifier == 2 { return sample(second).x() }
  if identifier == 3 { return sample(third).x() }
  return sample(first).x()
}

fun selected_target_y(identifier: Int64,
                      first: SpatialRenderable, second: SpatialRenderable,
                      third: SpatialRenderable): Float64<meter> {
  if identifier == 2 { return sample(second).y() }
  if identifier == 3 { return sample(third).y() }
  return sample(first).y()
}

fun selected_camera_z(identifier: Int64,
                      first: SpatialRenderable, second: SpatialRenderable,
                      third: SpatialRenderable): Float64<meter> {
  if identifier == 2 { return sample(second).z() + EARTH_VIEW_DISTANCE }
  if identifier == 3 { return sample(third).z() + MOON_VIEW_DISTANCE }
  return sample(first).z() + SUN_VIEW_DISTANCE
}

fun compose(camera_x: Float64<meter>, camera_y: Float64<meter>,
            camera_z: Float64<meter>, selection: SelectionState,
            first: SpatialRenderable, second: SpatialRenderable,
            third: SpatialRenderable): Void {
  let window_width = width()
  let window_height = height()
  let viewport_x = 24.0
  let viewport_y = 76.0
  let viewport_width = window_width - 48.0
  let viewport_height = window_height - 116.0
  begin()
  fill(0.0, 0.0, window_width, window_height, 7, 17, 31)
  text(24.0, 22.0, "SUN - EARTH - MOON SNAPSHOT", 16.0, 245, 249, 255)
  text(24.0, 48.0, "LEFT/RIGHT: SELECT | ENTER: FOCUS | R: SYSTEM | CLICK: PICK", 10.0,
       142, 203, 255)
  fill(viewport_x, viewport_y, viewport_width, viewport_height, 2, 6, 11)
  draw_object(first, camera_x, camera_y, camera_z,
              viewport_x, viewport_y, viewport_width, viewport_height,
              selection.is_selected(1))
  draw_object(second, camera_x, camera_y, camera_z,
              viewport_x, viewport_y, viewport_width, viewport_height,
              selection.is_selected(2))
  draw_object(third, camera_x, camera_y, camera_z,
              viewport_x, viewport_y, viewport_width, viewport_height,
              selection.is_selected(3))
  text(24.0, window_height - 28.0,
       "UNIT-TYPED DISTANCES - CAMERA FRAMING CHANGES, BODIES DO NOT", 10.0,
       142, 164, 188)
  present()
}

if open("Sagan Sun-Earth-Moon scene", 960, 540) {
  let selection = SelectionState()
  selection.select!(1)
  let camera_x = DISTANT_ORIGIN + EARTH_DISTANCE / 2.0
  let camera_y = DISTANT_ORIGIN
  let camera_z = DISTANT_ORIGIN
  let system_camera_x = camera_x
  let system_camera_y = camera_y
  let system_camera_z = camera_z
  let focus_start_x = camera_x
  let focus_start_y = camera_y
  let focus_start_z = camera_z
  let focus_target_x = camera_x
  let focus_target_y = camera_y
  let focus_target_z = camera_z
  let focus_started = 0.0
  let focusing = false
  let focused_identifier: Int64 = 0
  let running = true
  while running {
    if poll() == false { running = false }
    if running {
      // Accelerated, circular, demo-owned snapshot generation. This is not an
      // n-body integrator and is intentionally replaceable by physics output.
      let earth_phase = elapsed_seconds() * 0.08
      let moon_phase = earth_phase * 13.368746
      let earth_x = DISTANT_ORIGIN + EARTH_DISTANCE * demo_cosine(earth_phase)
      let earth_y = DISTANT_ORIGIN + EARTH_DISTANCE * demo_sine(earth_phase)
      let first = PresentationObject(
        1, DISTANT_ORIGIN, DISTANT_ORIGIN, DISTANT_ORIGIN - CAMERA_DEPTH,
        696340.0 kilometer, "SUN")
      let second = PresentationObject(
        2, earth_x, earth_y, DISTANT_ORIGIN - CAMERA_DEPTH,
        6371.0 kilometer, "EARTH")
      let third = PresentationObject(
        3, earth_x + MOON_DISTANCE * demo_cosine(moon_phase),
        earth_y + MOON_DISTANCE * demo_sine(moon_phase),
        DISTANT_ORIGIN - CAMERA_DEPTH, 1737.4 kilometer, "MOON")
      if key_pressed("left") {
        let previous = selection.identifier() - 1
        if previous < 1 { previous = 3 }
        selection.select!(previous)
      }
      if key_pressed("right") {
        let next = selection.identifier() + 1
        if next > 3 { next = 1 }
        selection.select!(next)
      }
      let viewport_x = 24.0
      let viewport_y = 76.0
      let viewport_width = width() - 48.0
      let viewport_height = height() - 116.0
      if pointer_pressed() {
        let click_x = pointer_x()
        let click_y = pointer_y()
        if pick_circle(click_x, click_y,
                       projected_x(first, camera_x, camera_z,
                                   viewport_x, viewport_width),
                       projected_y(first, camera_y, camera_z,
                                   viewport_y, viewport_height),
                       34.0) { selection.select!(1) }
        if pick_circle(click_x, click_y,
                       projected_x(second, camera_x, camera_z,
                                   viewport_x, viewport_width),
                       projected_y(second, camera_y, camera_z,
                                   viewport_y, viewport_height),
                       24.0) { selection.select!(2) }
        if pick_circle(click_x, click_y,
                       projected_x(third, camera_x, camera_z,
                                   viewport_x, viewport_width) +
                         moon_marker_offset(camera_z, third),
                       projected_y(third, camera_y, camera_z,
                                   viewport_y, viewport_height),
                       24.0) { selection.select!(3) }
      }
      if key_pressed("enter") {
        focus_start_x = camera_x
        focus_start_y = camera_y
        focus_start_z = camera_z
        focus_target_x = selected_target_x(selection.identifier(), first, second, third)
        focus_target_y = selected_target_y(selection.identifier(), first, second, third)
        focus_target_z = selected_camera_z(selection.identifier(), first, second, third)
        focus_started = elapsed_seconds()
        focusing = true
        focused_identifier = selection.identifier()
      }
      if key_pressed("r") {
        focus_start_x = camera_x
        focus_start_y = camera_y
        focus_start_z = camera_z
        focus_target_x = system_camera_x
        focus_target_y = system_camera_y
        focus_target_z = system_camera_z
        focus_started = elapsed_seconds()
        focusing = true
        focused_identifier = 0
      }
      if focusing {
        let focus_elapsed = elapsed_seconds() - focus_started
        camera_x = smooth_focus_axis(focus_start_x, focus_target_x, focus_elapsed, 1.2)
        camera_y = smooth_focus_axis(focus_start_y, focus_target_y, focus_elapsed, 1.2)
        camera_z = smooth_focus_axis(focus_start_z, focus_target_z, focus_elapsed, 1.2)
        if focus_elapsed >= 1.2 { focusing = false }
      }
      if focusing == false {
        if focused_identifier > 0 {
          camera_x = selected_target_x(focused_identifier, first, second, third)
          camera_y = selected_target_y(focused_identifier, first, second, third)
        }
      }
      compose(camera_x, camera_y, camera_z, selection, first, second, third)
    }
  }
  close()
}
