const DISTANT_ORIGIN: Float64<meter> = 1e12 kilometer
const CAMERA_DEPTH: Float64<meter> = 3.3e8 kilometer
const EARTH_DISTANCE: Float64<meter> = 1.495978707e8 kilometer
const MOON_DISTANCE: Float64<meter> = 3.844e5 kilometer
// Family framing includes a margin beyond the outermost demonstrated child
// orbit at the 60-degree vertical field of view.
const SUN_VIEW_DISTANCE: Float64<meter> = 3.3e8 kilometer
const EARTH_VIEW_DISTANCE: Float64<meter> = 8e4 kilometer
const MOON_VIEW_DISTANCE: Float64<meter> = 3e4 kilometer
const FOCUS_DURATION_SECONDS: Float64 = 3.0
const SURFACE_HANDOFF_DURATION_SECONDS: Float64 = 5.0
const LOCAL_VIEW_DISTANCE: Float64<meter> = 620.0 meter
const LOCAL_CAMERA_YAW: Float64 = 1.1141073978524427
const LOCAL_CAMERA_PITCH: Float64 = 0.8842037800659589
const LOCAL_CAMERA_ROLL: Float64 = 0.0 - 1.5430291992600365
const ANCESTOR_FOCUS_DURATION_SECONDS: Float64 = 4.0
const LARGE_SCALE_FOCUS_DURATION_SECONDS: Float64 = 6.0

fun wrapped_angle(value: Float64): Float64 {
  let result = value
  while result > 3.141592653589793 { result = result - 6.283185307179586 }
  while result < 0.0 - 3.141592653589793 { result = result + 6.283185307179586 }
  return result
}

/// Demo-only trigonometric approximation. Authoritative orbital state belongs
/// in sagan-physics; the renderer receives only the resulting snapshots.
fun demo_sine(value: Float64): Float64 {
  let angle = wrapped_angle(value)
  // Reduce to [-pi/2, pi/2] before evaluating the polynomial. Evaluating the
  // truncated series near +/-pi produced a visible seam and a non-circular
  // orbit guide even though the body and guide shared the same nominal radius.
  if angle > 1.5707963267948966 {
    angle = 3.141592653589793 - angle
  }
  if angle < 0.0 - 1.5707963267948966 {
    angle = 0.0 - 3.141592653589793 - angle
  }
  let squared = angle * angle
  return angle * (1.0 - squared / 6.0 + squared * squared / 120.0 -
                  squared * squared * squared / 5040.0)
}

fun demo_cosine(value: Float64): Float64 {
  let angle = wrapped_angle(value)
  let sign = 1.0
  if angle > 1.5707963267948966 {
    angle = 3.141592653589793 - angle
    sign = 0.0 - 1.0
  }
  if angle < 0.0 - 1.5707963267948966 {
    angle = 0.0 - 3.141592653589793 - angle
    sign = 0.0 - 1.0
  }
  let squared = angle * angle
  return sign * (1.0 - squared / 2.0 + squared * squared / 24.0 -
                 squared * squared * squared / 720.0)
}

fun clamp_pitch(value: Float64): Float64 {
  // Elevation is measured from the orbital horizon: +pi/2 is exact top-down,
  // zero is the horizon, and -1.18 stops about 22 degrees before full bottom.
  if value > 1.5707963267948966 { return 1.5707963267948966 }
  if value < 0.0 - 1.18 { return 0.0 - 1.18 }
  return value
}

fun clamp_distance(value: Float64<meter>): Float64<meter> {
  if value < 12000.0 kilometer { return 12000.0 kilometer }
  if value > 600000000.0 kilometer { return 600000000.0 kilometer }
  return value
}

fun zoom_distance(value: Float64<meter>, wheel: Float64): Float64<meter> {
  let factor = 1.0 - wheel * 0.12
  if factor < 0.25 { factor = 0.25 }
  if factor > 4.0 { factor = 4.0 }
  return clamp_distance(value * factor)
}

fun focus_progress(elapsed_seconds: Float64,
                   duration_seconds: Float64): Float64 {
  let progress = elapsed_seconds / duration_seconds
  if progress <= 0.0 { return 0.0 }
  if progress >= 1.0 { return 1.0 }
  return progress * progress * (3.0 - 2.0 * progress)
}

fun focus_axis_at(start: Float64<meter>, target: Float64<meter>,
                  progress: Float64): Float64<meter> {
  return start + (target - start) * progress
}

fun focus_scalar_at(start: Float64, target: Float64,
                    progress: Float64): Float64 {
  return start + (target - start) * progress
}

/// Interpolate reciprocal distance because apparent scale is proportional to
/// reciprocal distance. The caller independently chooses whether zoom leads
/// or trails target translation.
fun focus_distance_at(start: Float64<meter>, target: Float64<meter>,
                      progress: Float64): Float64<meter> {
  return start * target / (target + (start - target) * progress)
}

class PresentationObject has SpatialRenderable {
  let identifier_value: Int64
  let x_value: Float64<meter>
  let y_value: Float64<meter>
  let z_value: Float64<meter>
  let radius_value: Float64<meter>
  let label_value: String

  new(identifier: Int64, x: Float64<meter>, y: Float64<meter>,
      z: Float64<meter>, radius: Float64<meter>, label: String) {
    self.identifier_value = identifier
    self.x_value = x
    self.y_value = y
    self.z_value = z
    self.radius_value = radius
    self.label_value = label
  }

  fun render_identifier(): Int64 => self.identifier_value
  fun render_x(): Float64<meter> => self.x_value
  fun render_y(): Float64<meter> => self.y_value
  fun render_z(): Float64<meter> => self.z_value
  fun render_radius(): Float64<meter> => self.radius_value
  fun render_label(): String => self.label_value
}

fun marker_x(marker: SurfaceLocationMarker,
             moon: SpatialRenderable): Float64<meter> {
  let moon_sample = sample(moon)
  let surface_radius = moon_sample.radius() + marker.altitude()
  return moon_sample.x() + surface_radius *
    demo_cosine(marker.latitude_radians()) *
    demo_cosine(marker.longitude_radians())
}

fun marker_y(marker: SurfaceLocationMarker,
             moon: SpatialRenderable): Float64<meter> {
  let moon_sample = sample(moon)
  let surface_radius = moon_sample.radius() + marker.altitude()
  return moon_sample.y() + surface_radius *
    demo_cosine(marker.latitude_radians()) *
    demo_sine(marker.longitude_radians())
}

fun marker_z(marker: SurfaceLocationMarker,
             moon: SpatialRenderable): Float64<meter> {
  let moon_sample = sample(moon)
  return moon_sample.z() +
    (moon_sample.radius() + marker.altitude()) *
    demo_sine(marker.latitude_radians())
}

fun marker_presentation(marker: SurfaceLocationMarker,
                        moon: SpatialRenderable): SpatialRenderable =>
  PresentationObject(marker.identifier(), marker_x(marker, moon),
                     marker_y(marker, moon), marker_z(marker, moon),
                     1.0 meter, marker.label())

fun local_target_x(marker: SurfaceLocationMarker,
                   marker_value: SpatialRenderable): Float64<meter> {
  let east_x = 0.0 - demo_sine(marker.longitude_radians())
  let north_x = 0.0 - demo_sine(marker.latitude_radians()) *
                demo_cosine(marker.longitude_radians())
  let up_x = demo_cosine(marker.latitude_radians()) *
             demo_cosine(marker.longitude_radians())
  return sample(marker_value).x() + east_x * (0.0 meter - 15.0 meter) +
         north_x * (0.0 meter - 5.0 meter) + up_x * 4.0 meter
}

fun local_target_y(marker: SurfaceLocationMarker,
                   marker_value: SpatialRenderable): Float64<meter> {
  let east_y = demo_cosine(marker.longitude_radians())
  let north_y = 0.0 - demo_sine(marker.latitude_radians()) *
                demo_sine(marker.longitude_radians())
  let up_y = demo_cosine(marker.latitude_radians()) *
             demo_sine(marker.longitude_radians())
  return sample(marker_value).y() + east_y * (0.0 meter - 15.0 meter) +
         north_y * (0.0 meter - 5.0 meter) + up_y * 4.0 meter
}

fun local_target_z(marker: SurfaceLocationMarker,
                   marker_value: SpatialRenderable): Float64<meter> {
  let north_z = demo_cosine(marker.latitude_radians())
  let up_z = demo_sine(marker.latitude_radians())
  return sample(marker_value).z() + north_z * (0.0 meter - 5.0 meter) +
         up_z * 4.0 meter
}

fun marker_faces_camera(marker_value: SpatialRenderable,
                        moon: SpatialRenderable,
                        camera_x: Float64<meter>,
                        camera_y: Float64<meter>,
                        camera_z: Float64<meter>): Bool {
  let location = sample(marker_value)
  let body = sample(moon)
  return surface_location_visible(
    location.x(), location.y(), location.z(),
    body.x(), body.y(), body.z(), camera_x, camera_y, camera_z)
}

fun draw_local_box(viewport_x: Float64, viewport_y: Float64,
                   viewport_width: Float64, viewport_height: Float64,
                   camera_x: Float64<meter>, camera_y: Float64<meter>,
                   camera_z: Float64<meter>, forward_x: Float64,
                   forward_y: Float64, forward_z: Float64,
                   up_x: Float64, up_y: Float64, up_z: Float64,
                   origin_x: Float64<meter>, origin_y: Float64<meter>,
                   origin_z: Float64<meter>, x: Float64<meter>,
                   y: Float64<meter>, z: Float64<meter>,
                   east_x: Float64, east_y: Float64, east_z: Float64,
                   north_x: Float64, north_y: Float64, north_z: Float64,
                   surface_up_x: Float64, surface_up_y: Float64,
                   surface_up_z: Float64,
                   half_x: Float64<meter>, half_y: Float64<meter>,
                   half_z: Float64<meter>, yaw: Float64,
                   appearance: Int64): Void {
  let yaw_cosine = demo_cosine(yaw)
  let yaw_sine = demo_sine(yaw)
  let axis_x_x = east_x * yaw_cosine + north_x * yaw_sine
  let axis_x_y = east_y * yaw_cosine + north_y * yaw_sine
  let axis_x_z = east_z * yaw_cosine + north_z * yaw_sine
  let axis_y_x = north_x * yaw_cosine - east_x * yaw_sine
  let axis_y_y = north_y * yaw_cosine - east_y * yaw_sine
  let axis_y_z = north_z * yaw_cosine - east_z * yaw_sine
  mesh_box_frame(viewport_x, viewport_y, viewport_width, viewport_height,
                 camera_x, camera_y, camera_z,
                 forward_x, forward_y, forward_z, up_x, up_y, up_z,
                 0.8726646259971648, 1.0 meter, 4000000.0 meter,
                 origin_x + east_x * x + north_x * y + surface_up_x * z,
                 origin_y + east_y * x + north_y * y + surface_up_y * z,
                 origin_z + east_z * x + north_z * y + surface_up_z * z,
                 half_x, half_y, half_z,
                 axis_x_x, axis_x_y, axis_x_z,
                 axis_y_x, axis_y_y, axis_y_z,
                 surface_up_x, surface_up_y, surface_up_z, appearance)
}

fun draw_local_base_scene(marker: SurfaceLocationMarker,
                          marker_value: SpatialRenderable,
                          camera_x: Float64<meter>, camera_y: Float64<meter>,
                          camera_z: Float64<meter>, camera_yaw: Float64,
                          camera_pitch: Float64, camera_roll: Float64,
                          viewport_x: Float64, viewport_y: Float64,
                          viewport_width: Float64,
                          viewport_height: Float64): Void {
  let marker_sample = sample(marker_value)
  let latitude_cosine = demo_cosine(marker.latitude_radians())
  let latitude_sine = demo_sine(marker.latitude_radians())
  let longitude_cosine = demo_cosine(marker.longitude_radians())
  let longitude_sine = demo_sine(marker.longitude_radians())
  let surface_up_x = latitude_cosine * longitude_cosine
  let surface_up_y = latitude_cosine * longitude_sine
  let surface_up_z = latitude_sine
  let east_x = 0.0 - longitude_sine
  let east_y = longitude_cosine
  let east_z = 0.0
  let north_x = 0.0 - latitude_sine * longitude_cosine
  let north_y = 0.0 - latitude_sine * longitude_sine
  let north_z = latitude_cosine
  let pitch_cosine = demo_cosine(camera_pitch)
  let pitch_sine = demo_sine(camera_pitch)
  let yaw_cosine = demo_cosine(camera_yaw)
  let yaw_sine = demo_sine(camera_yaw)
  let roll_cosine = demo_cosine(camera_roll)
  let roll_sine = demo_sine(camera_roll)
  let forward_x = 0.0 - yaw_cosine * pitch_cosine
  let forward_y = 0.0 - yaw_sine * pitch_cosine
  let forward_z = 0.0 - pitch_sine
  let base_up_x = 0.0 - yaw_cosine * pitch_sine
  let base_up_y = 0.0 - yaw_sine * pitch_sine
  let base_up_z = pitch_cosine
  let right_x = 0.0 - yaw_sine
  let right_y = yaw_cosine
  let up_x = base_up_x * roll_cosine + right_x * roll_sine
  let up_y = base_up_y * roll_cosine + right_y * roll_sine
  let up_z = base_up_z * roll_cosine
  draw_local_box(viewport_x, viewport_y, viewport_width, viewport_height,
                 camera_x, camera_y, camera_z,
                 forward_x, forward_y, forward_z, up_x, up_y, up_z,
                 marker_sample.x(), marker_sample.y(), marker_sample.z(),
                 115.0 meter, 70.0 meter, 6.0 meter,
                 east_x, east_y, east_z, north_x, north_y, north_z,
                 surface_up_x, surface_up_y, surface_up_z,
                 72.0 meter, 72.0 meter, 1.0 meter, 0.0, 11)
  draw_local_box(viewport_x, viewport_y, viewport_width, viewport_height,
                 camera_x, camera_y, camera_z,
                 forward_x, forward_y, forward_z, up_x, up_y, up_z,
                 marker_sample.x(), marker_sample.y(), marker_sample.z(),
                 115.0 meter, 70.0 meter, 22.0 meter,
                 east_x, east_y, east_z, north_x, north_y, north_z,
                 surface_up_x, surface_up_y, surface_up_z,
                 18.0 meter, 13.0 meter, 9.0 meter, 0.35, 12)
  draw_local_box(viewport_x, viewport_y, viewport_width, viewport_height,
                 camera_x, camera_y, camera_z,
                 forward_x, forward_y, forward_z, up_x, up_y, up_z,
                 marker_sample.x(), marker_sample.y(), marker_sample.z(),
                 0.0 meter - 95.0 meter, 25.0 meter, 19.0 meter,
                 east_x, east_y, east_z, north_x, north_y, north_z,
                 surface_up_x, surface_up_y, surface_up_z,
                 54.0 meter, 25.0 meter, 14.0 meter, 0.0 - 0.18, 12)
  draw_local_box(viewport_x, viewport_y, viewport_width, viewport_height,
                 camera_x, camera_y, camera_z,
                 forward_x, forward_y, forward_z, up_x, up_y, up_z,
                 marker_sample.x(), marker_sample.y(), marker_sample.z(),
                 0.0 meter - 130.0 meter, 0.0 meter - 55.0 meter,
                 16.0 meter,
                 east_x, east_y, east_z, north_x, north_y, north_z,
                 surface_up_x, surface_up_y, surface_up_z,
                 38.0 meter, 22.0 meter, 11.0 meter, 0.25, 12)
  draw_local_box(viewport_x, viewport_y, viewport_width, viewport_height,
                 camera_x, camera_y, camera_z,
                 forward_x, forward_y, forward_z, up_x, up_y, up_z,
                 marker_sample.x(), marker_sample.y(), marker_sample.z(),
                 0.0 meter - 10.0 meter, 0.0 meter - 135.0 meter,
                 9.0 meter,
                 east_x, east_y, east_z, north_x, north_y, north_z,
                 surface_up_x, surface_up_y, surface_up_z,
                 92.0 meter, 28.0 meter, 2.0 meter,
                 0.0 - 0.12, 14)
  draw_local_box(viewport_x, viewport_y, viewport_width, viewport_height,
                 camera_x, camera_y, camera_z,
                 forward_x, forward_y, forward_z, up_x, up_y, up_z,
                 marker_sample.x(), marker_sample.y(), marker_sample.z(),
                 0.0 meter - 205.0 meter, 85.0 meter, 42.0 meter,
                 east_x, east_y, east_z, north_x, north_y, north_z,
                 surface_up_x, surface_up_y, surface_up_z,
                 5.0 meter, 5.0 meter, 38.0 meter, 0.0, 13)
  mesh_sphere(viewport_x, viewport_y, viewport_width, viewport_height,
              camera_x, camera_y, camera_z,
              forward_x, forward_y, forward_z, up_x, up_y, up_z,
              0.8726646259971648, 1.0 meter, 4000000.0 meter,
              marker_sample.x() + east_x * (0.0 meter - 70.0 meter) + north_x * 18.0 meter + surface_up_x * 31.0 meter,
              marker_sample.y() + east_y * (0.0 meter - 70.0 meter) + north_y * 18.0 meter + surface_up_y * 31.0 meter,
              marker_sample.z() + east_z * (0.0 meter - 70.0 meter) + north_z * 18.0 meter + surface_up_z * 31.0 meter,
              17.0 meter, 3, false)
}

fun moon_marker_offset(camera_z: Float64<meter>, moon: SpatialRenderable): Float64 {
  if camera_z - sample(moon).z() > 10000000.0 kilometer { return 48.0 }
  return 0.0
}

fun draw_object(value: SpatialRenderable,
                camera_x: Float64<meter>, camera_y: Float64<meter>,
                camera_z: Float64<meter>, camera_yaw: Float64,
                camera_pitch: Float64, camera_roll: Float64,
                viewport_x: Float64,
                viewport_y: Float64, viewport_width: Float64,
                viewport_height: Float64,
                near_distance: Float64<meter>,
                far_distance: Float64<meter>, selected: Bool): Void {
  let item: RenderSample = sample(value)
  let pitch_cosine = demo_cosine(camera_pitch)
  let pitch_sine = demo_sine(camera_pitch)
  let yaw_cosine = demo_cosine(camera_yaw)
  let yaw_sine = demo_sine(camera_yaw)
  let roll_cosine = demo_cosine(camera_roll)
  let roll_sine = demo_sine(camera_roll)
  let forward_x = 0.0 - yaw_cosine * pitch_cosine
  let forward_y = 0.0 - yaw_sine * pitch_cosine
  let forward_z = 0.0 - pitch_sine
  let base_up_x = 0.0 - yaw_cosine * pitch_sine
  let base_up_y = 0.0 - yaw_sine * pitch_sine
  let base_up_z = pitch_cosine
  let base_right_x = 0.0 - yaw_sine
  let base_right_y = yaw_cosine
  let camera_up_x = base_up_x * roll_cosine + base_right_x * roll_sine
  let camera_up_y = base_up_y * roll_cosine + base_right_y * roll_sine
  let camera_up_z = base_up_z * roll_cosine
  let camera_right_x = base_right_x * roll_cosine - base_up_x * roll_sine
  let camera_right_y = base_right_y * roll_cosine - base_up_y * roll_sine
  let camera_right_z = 0.0 - base_up_z * roll_sine
  let relative_x = relative_axis(item.x(), camera_x)
  let relative_y = relative_axis(item.y(), camera_y)
  let relative_z = relative_axis(item.z(), camera_z)
  let camera_right = relative_x * camera_right_x +
                     relative_y * camera_right_y +
                     relative_z * camera_right_z
  let camera_up = relative_x * camera_up_x + relative_y * camera_up_y +
                  relative_z * camera_up_z
  let forward_depth = relative_x * forward_x + relative_y * forward_y +
                      relative_z * forward_z
  if depth_visible(forward_depth, item.radius(),
                   1.0 kilometer, 1000000000.0 kilometer) {
    let logical_x = viewport_x + perspective_axis(
      camera_right * viewport_height / viewport_width,
      forward_depth, 0.577350269, viewport_width)
    let logical_y = viewport_y + perspective_axis(
      0.0 meter - camera_up, forward_depth,
      0.577350269, viewport_height)
    let label_offset_x = 0.0
    if item.identifier() == 3 {
      label_offset_x = moon_marker_offset(camera_z, value)
    }
    let projected_radius =
      (item.radius() / forward_depth) / 0.577350269 * viewport_height / 2.0
    mesh_sphere(viewport_x, viewport_y, viewport_width, viewport_height,
                camera_x, camera_y, camera_z,
                forward_x, forward_y, forward_z,
                camera_up_x, camera_up_y, camera_up_z, 1.0471975511965976,
                near_distance, far_distance,
                item.x(), item.y(), item.z(), item.radius(),
                item.identifier(), selected)
    text(logical_x + label_offset_x + projected_radius + 7.0, logical_y - 5.0,
         item.label(), 10.0, 245, 249, 255)
  }
}

fun projected_x(value: SpatialRenderable, camera_x: Float64<meter>,
                camera_y: Float64<meter>, camera_z: Float64<meter>,
                camera_yaw: Float64, camera_pitch: Float64,
                camera_roll: Float64,
                viewport_x: Float64, viewport_width: Float64,
                viewport_height: Float64): Float64 {
  let item: RenderSample = sample(value)
  let pitch_cosine = demo_cosine(camera_pitch)
  let pitch_sine = demo_sine(camera_pitch)
  let yaw_cosine = demo_cosine(camera_yaw)
  let yaw_sine = demo_sine(camera_yaw)
  let roll_cosine = demo_cosine(camera_roll)
  let roll_sine = demo_sine(camera_roll)
  let relative_x = relative_axis(item.x(), camera_x)
  let relative_y = relative_axis(item.y(), camera_y)
  let relative_z = relative_axis(item.z(), camera_z)
  let base_up_x = 0.0 - yaw_cosine * pitch_sine
  let base_up_y = 0.0 - yaw_sine * pitch_sine
  let base_up_z = pitch_cosine
  let camera_right_x = (0.0 - yaw_sine) * roll_cosine -
                       base_up_x * roll_sine
  let camera_right_y = yaw_cosine * roll_cosine - base_up_y * roll_sine
  let camera_right_z = 0.0 - base_up_z * roll_sine
  let camera_right = relative_x * camera_right_x +
                     relative_y * camera_right_y +
                     relative_z * camera_right_z
  let forward_depth = relative_x * (0.0 - yaw_cosine * pitch_cosine) +
                      relative_y * (0.0 - yaw_sine * pitch_cosine) -
                      relative_z * pitch_sine
  return viewport_x + perspective_axis(
    camera_right * viewport_height / viewport_width,
    forward_depth, 0.577350269, viewport_width)
}

fun projected_y(value: SpatialRenderable, camera_x: Float64<meter>,
                camera_y: Float64<meter>, camera_z: Float64<meter>,
                camera_yaw: Float64, camera_pitch: Float64,
                camera_roll: Float64,
                viewport_y: Float64, viewport_height: Float64): Float64 {
  let item: RenderSample = sample(value)
  let pitch_cosine = demo_cosine(camera_pitch)
  let pitch_sine = demo_sine(camera_pitch)
  let yaw_cosine = demo_cosine(camera_yaw)
  let yaw_sine = demo_sine(camera_yaw)
  let roll_cosine = demo_cosine(camera_roll)
  let roll_sine = demo_sine(camera_roll)
  let relative_x = relative_axis(item.x(), camera_x)
  let relative_y = relative_axis(item.y(), camera_y)
  let relative_z = relative_axis(item.z(), camera_z)
  let base_up_x = 0.0 - yaw_cosine * pitch_sine
  let base_up_y = 0.0 - yaw_sine * pitch_sine
  let base_up_z = pitch_cosine
  let camera_up_x = base_up_x * roll_cosine +
                    (0.0 - yaw_sine) * roll_sine
  let camera_up_y = base_up_y * roll_cosine + yaw_cosine * roll_sine
  let camera_up_z = base_up_z * roll_cosine
  let camera_up = relative_x * camera_up_x + relative_y * camera_up_y +
                  relative_z * camera_up_z
  let forward_depth = relative_x * (0.0 - yaw_cosine * pitch_cosine) +
                      relative_y * (0.0 - yaw_sine * pitch_cosine) -
                      relative_z * pitch_sine
  return viewport_y + perspective_axis(
    0.0 meter - camera_up, forward_depth,
    0.577350269, viewport_height)
}

fun projected_depth(value: SpatialRenderable,
                    camera_x: Float64<meter>, camera_y: Float64<meter>,
                    camera_z: Float64<meter>, camera_yaw: Float64,
                    camera_pitch: Float64): Float64<meter> {
  let item: RenderSample = sample(value)
  let pitch_cosine = demo_cosine(camera_pitch)
  let relative_x = relative_axis(item.x(), camera_x)
  let relative_y = relative_axis(item.y(), camera_y)
  let relative_z = relative_axis(item.z(), camera_z)
  return relative_x * (0.0 - demo_cosine(camera_yaw) * pitch_cosine) +
         relative_y * (0.0 - demo_sine(camera_yaw) * pitch_cosine) -
         relative_z * demo_sine(camera_pitch)
}

fun draw_surface_marker(marker: SurfaceLocationMarker,
                        marker_value: SpatialRenderable,
                        moon: SpatialRenderable,
                        camera_x: Float64<meter>,
                        camera_y: Float64<meter>,
                        camera_z: Float64<meter>, camera_yaw: Float64,
                        camera_pitch: Float64, camera_roll: Float64,
                        viewport_x: Float64,
                        viewport_y: Float64, viewport_width: Float64,
                        viewport_height: Float64, hovered: Bool,
                        fade_stage: Int64): Void {
  let moon_depth = projected_depth(
    moon, camera_x, camera_y, camera_z, camera_yaw, camera_pitch)
  let moon_radius =
    (sample(moon).radius() / moon_depth) / 0.577350269 * viewport_height / 2.0
  if moon_radius > 15.0 {
    if marker_faces_camera(
         marker_value, moon, camera_x, camera_y, camera_z) {
      let surface_x = projected_x(
        marker_value, camera_x, camera_y, camera_z,
        camera_yaw, camera_pitch, camera_roll,
        viewport_x, viewport_width, viewport_height)
      let surface_y = projected_y(
        marker_value, camera_x, camera_y, camera_z,
        camera_yaw, camera_pitch, camera_roll, viewport_y, viewport_height)
      let icon_x = surface_x
      let icon_y = surface_y - 68.0
      let marker_red: Int64 = 255
      let marker_green: Int64 = 212
      let marker_blue: Int64 = 91
      if fade_stage == 2 {
        marker_red = 151
        marker_green = 91
        marker_blue = 24
      }
      if fade_stage == 1 {
        marker_red = 82
        marker_green = 91
        marker_blue = 105
      }
      if fade_stage == 0 {
        marker_red = 2
        marker_green = 6
        marker_blue = 11
      }
      if hovered {
        if fade_stage == 3 {
        let row = 0.0 - 7.0
        while row <= 7.0 {
          let distance = row
          if distance < 0.0 { distance = 0.0 - distance }
          let half_width = 8.0 - distance
          line(icon_x - half_width, icon_y + row,
               icon_x + half_width, icon_y + row, 1.5,
               viewport_x, viewport_y, viewport_width, viewport_height,
               marker_red, marker_green, marker_blue)
          row = row + 1.0
        }
        }
      }
      line(surface_x, surface_y, icon_x, icon_y + 8.0, 2.0,
           viewport_x, viewport_y, viewport_width, viewport_height,
           marker_red, marker_green, marker_blue)
      line(icon_x, icon_y - 8.0, icon_x + 8.0, icon_y, 2.0,
           viewport_x, viewport_y, viewport_width, viewport_height,
           marker_red, marker_green, marker_blue)
      line(icon_x + 8.0, icon_y, icon_x, icon_y + 8.0, 2.0,
           viewport_x, viewport_y, viewport_width, viewport_height,
           marker_red, marker_green, marker_blue)
      line(icon_x, icon_y + 8.0, icon_x - 8.0, icon_y, 2.0,
           viewport_x, viewport_y, viewport_width, viewport_height,
           marker_red, marker_green, marker_blue)
      line(icon_x - 8.0, icon_y, icon_x, icon_y - 8.0, 2.0,
           viewport_x, viewport_y, viewport_width, viewport_height,
           marker_red, marker_green, marker_blue)
      text(icon_x + 13.0, icon_y - 5.0, marker.label(), 10.0,
           marker_red, marker_green, marker_blue)
    }
  }
}

/// Demo-owned presentation of a circular path in physical XY space. The
/// perspective camera projects the circle to an ellipse. A future physics
/// package may supply sampled conic paths through the same generic line API.
fun draw_orbit(center_x: Float64<meter>, center_y: Float64<meter>,
               center_z: Float64<meter>, orbit_radius: Float64<meter>,
               camera_x: Float64<meter>, camera_y: Float64<meter>,
               camera_z: Float64<meter>, camera_yaw: Float64,
               camera_pitch: Float64, camera_roll: Float64,
               viewport_x: Float64,
               viewport_y: Float64, viewport_width: Float64,
               viewport_height: Float64, red: Int64, green: Int64,
               blue: Int64): Void {
  let segments: Int64 = 72
  let previous: SpatialRenderable = PresentationObject(
    0, center_x + orbit_radius, center_y, center_z, 1.0 meter, "")
  let previous_depth = projected_depth(
    previous, camera_x, camera_y, camera_z, camera_yaw, camera_pitch)
  let index: Int64 = 1
  let angle = 0.08726646259971647
  while index <= segments {
    let current: SpatialRenderable = PresentationObject(
      0, center_x + orbit_radius * demo_cosine(angle),
      center_y + orbit_radius * demo_sine(angle), center_z, 1.0 meter, "")
    let current_depth = projected_depth(
      current, camera_x, camera_y, camera_z, camera_yaw, camera_pitch)
    if previous_depth > 1000.0 kilometer {
      if current_depth > 1000.0 kilometer {
        line(projected_x(previous, camera_x, camera_y, camera_z,
                         camera_yaw, camera_pitch, camera_roll, viewport_x,
                         viewport_width, viewport_height),
             projected_y(previous, camera_x, camera_y, camera_z,
                         camera_yaw, camera_pitch, camera_roll,
                         viewport_y, viewport_height),
             projected_x(current, camera_x, camera_y, camera_z,
                         camera_yaw, camera_pitch, camera_roll, viewport_x,
                         viewport_width, viewport_height),
             projected_y(current, camera_x, camera_y, camera_z,
                         camera_yaw, camera_pitch, camera_roll,
                         viewport_y, viewport_height),
             1.25, viewport_x, viewport_y, viewport_width, viewport_height,
             red, green, blue)
      }
    }
    previous = current
    previous_depth = current_depth
    index = index + 1
    angle = angle + 0.08726646259971647
  }
}

fun selected_target_x(identifier: Int64,
                      first: SpatialRenderable, second: SpatialRenderable,
                      third: SpatialRenderable): Float64<meter> {
  if identifier == 2 { return sample(second).x() }
  if identifier == 3 { return sample(third).x() }
  return sample(first).x()
}

fun selected_target_y(identifier: Int64,
                      first: SpatialRenderable, second: SpatialRenderable,
                      third: SpatialRenderable): Float64<meter> {
  if identifier == 2 { return sample(second).y() }
  if identifier == 3 { return sample(third).y() }
  return sample(first).y()
}

fun selected_target_z(identifier: Int64,
                      first: SpatialRenderable, second: SpatialRenderable,
                      third: SpatialRenderable): Float64<meter> {
  if identifier == 2 { return sample(second).z() }
  if identifier == 3 { return sample(third).z() }
  return sample(first).z()
}

fun selected_view_distance(identifier: Int64): Float64<meter> {
  if identifier == 2 { return EARTH_VIEW_DISTANCE }
  if identifier == 3 { return MOON_VIEW_DISTANCE }
  return SUN_VIEW_DISTANCE
}

fun selected_camera_z(identifier: Int64,
                      first: SpatialRenderable, second: SpatialRenderable,
                      third: SpatialRenderable): Float64<meter> {
  if identifier == 2 { return sample(second).z() + EARTH_VIEW_DISTANCE }
  if identifier == 3 { return sample(third).z() + MOON_VIEW_DISTANCE }
  return sample(first).z() + SUN_VIEW_DISTANCE
}

fun compose(camera_x: Float64<meter>, camera_y: Float64<meter>,
            camera_z: Float64<meter>, camera_yaw: Float64,
            camera_pitch: Float64, camera_roll: Float64,
            selection: SelectionState,
            first: SpatialRenderable, second: SpatialRenderable,
            third: SpatialRenderable, marker: SurfaceLocationMarker,
            marker_value: SpatialRenderable, marker_active: Bool,
            marker_hovered: Bool, marker_fade_stage: Int64,
            surface_detail_active: Bool, transitioning: Bool): Void {
  let window_width = width()
  let window_height = height()
  let viewport_x = 24.0
  let viewport_y = 76.0
  let viewport_width = window_width - 48.0
  let viewport_height = window_height - 116.0
  begin()
  fill(0.0, 0.0, window_width, window_height, 7, 17, 31)
  text(24.0, 22.0, "SUN - EARTH - MOON SNAPSHOT", 16.0, 245, 249, 255)
  if surface_detail_active {
    if transitioning {
      text(24.0, 48.0, "DESCENDING - SAME MOON FRAME - LOCAL DETAIL ACTIVE",
           10.0, 255, 212, 91)
    } else {
      text(24.0, 48.0, "SHACKLETON BASE - SAME MOON FRAME",
           10.0, 142, 203, 255)
    }
  } else {
  if marker_active {
    text(24.0, 48.0, "APPROACHING SHACKLETON BASE", 10.0, 255, 212, 91)
  } else {
    text(24.0, 48.0, "RIGHT-DRAG: ORBIT | WHEEL: ZOOM | CLICK: SELECT | ENTER: FOCUS", 10.0,
         142, 203, 255)
  }
  }
  fill(viewport_x, viewport_y, viewport_width, viewport_height, 2, 6, 11)
  let sun_sample = sample(first)
  let earth_sample = sample(second)
  let moon_sample = sample(third)
  let scene_near: Float64<meter> = 1000.0 kilometer
  let scene_far: Float64<meter> = 500000000.0 kilometer
  if surface_detail_active {
    scene_near = 1.0 meter
    scene_far = 4000000.0 meter
  }
  draw_orbit(sun_sample.x(), sun_sample.y(), sun_sample.z(), EARTH_DISTANCE,
             camera_x, camera_y, camera_z, camera_yaw, camera_pitch,
             camera_roll,
             viewport_x, viewport_y, viewport_width, viewport_height,
             47, 75, 104)
  draw_orbit(earth_sample.x(), earth_sample.y(), earth_sample.z(), MOON_DISTANCE,
             camera_x, camera_y, camera_z, camera_yaw, camera_pitch,
             camera_roll,
             viewport_x, viewport_y, viewport_width, viewport_height,
             70, 92, 118)
  draw_object(first, camera_x, camera_y, camera_z, camera_yaw, camera_pitch,
              camera_roll,
              viewport_x, viewport_y, viewport_width, viewport_height,
              scene_near, scene_far,
              selection.is_selected(1))
  draw_object(second, camera_x, camera_y, camera_z, camera_yaw, camera_pitch,
              camera_roll,
              viewport_x, viewport_y, viewport_width, viewport_height,
              scene_near, scene_far,
              selection.is_selected(2))
  draw_object(third, camera_x, camera_y, camera_z, camera_yaw, camera_pitch,
              camera_roll,
              viewport_x, viewport_y, viewport_width, viewport_height,
              scene_near, scene_far,
              selection.is_selected(3))
  if surface_detail_active {
    draw_local_base_scene(marker, marker_value,
                          camera_x, camera_y, camera_z,
                          camera_yaw, camera_pitch, camera_roll,
                          viewport_x, viewport_y,
                          viewport_width, viewport_height)
  }
  draw_surface_marker(marker, marker_value, third,
                      camera_x, camera_y, camera_z,
                      camera_yaw, camera_pitch, camera_roll,
                      viewport_x, viewport_y, viewport_width, viewport_height,
                      marker_hovered, marker_fade_stage)
  text(24.0, window_height - 28.0,
       "UNIT-TYPED DISTANCES - CAMERA FRAMING CHANGES, BODIES DO NOT", 10.0,
       142, 164, 188)
  present()
}

if open("Sagan Sun-Earth-Moon scene", 960, 540) {
  let selection = SelectionState()
  selection.select!(1)
  let base_marker = SurfaceLocationMarker(
    40, 3, 400, 0.5235987755982988, 0.0,
    10.0 meter, "SHACKLETON BASE")
  let camera_yaw = 0.0
  // Begin 30 degrees above the orbital horizon rather than at the top pole.
  let camera_pitch = 0.5235987755982988
  let camera_roll = 0.0
  let orbit_target_x = DISTANT_ORIGIN
  let orbit_target_y = DISTANT_ORIGIN
  let orbit_target_z = DISTANT_ORIGIN - CAMERA_DEPTH
  let camera_distance = SUN_VIEW_DISTANCE
  let camera_x = orbit_target_x + 0.8660254037844386 * camera_distance
  let camera_y = orbit_target_y
  let camera_z = orbit_target_z + 0.5 * camera_distance
  let focus_start_x = orbit_target_x
  let focus_start_y = orbit_target_y
  let focus_start_z = orbit_target_z
  let focus_start_distance = camera_distance
  let focus_start_yaw = camera_yaw
  let focus_start_pitch = camera_pitch
  let focus_start_roll = camera_roll
  let focus_target_x = orbit_target_x
  let focus_target_y = orbit_target_y
  let focus_target_z = orbit_target_z
  let focus_target_distance = camera_distance
  let focus_started = 0.0
  let focus_duration = FOCUS_DURATION_SECONDS
  let focusing = false
  let focus_source_identifier: Int64 = 0
  let focused_identifier: Int64 = 1
  let focused_marker = false
  let local_view = false
  let running = true
  while running {
    if poll() == false { running = false }
    if running {
      // Accelerated, circular, demo-owned snapshot generation. This is not an
      // n-body integrator and is intentionally replaceable by physics output.
      let earth_phase = elapsed_seconds() * 0.08
      let moon_phase = earth_phase * 13.368746
      let earth_x = DISTANT_ORIGIN + EARTH_DISTANCE * demo_cosine(earth_phase)
      let earth_y = DISTANT_ORIGIN + EARTH_DISTANCE * demo_sine(earth_phase)
      let first = PresentationObject(
        1, DISTANT_ORIGIN, DISTANT_ORIGIN, DISTANT_ORIGIN - CAMERA_DEPTH,
        696340.0 kilometer, "SUN")
      let second = PresentationObject(
        2, earth_x, earth_y, DISTANT_ORIGIN - CAMERA_DEPTH,
        6371.0 kilometer, "EARTH")
      let third = PresentationObject(
        3, earth_x + MOON_DISTANCE * demo_cosine(moon_phase),
        earth_y + MOON_DISTANCE * demo_sine(moon_phase),
        DISTANT_ORIGIN - CAMERA_DEPTH, 1737.4 kilometer, "MOON")
      let marker_value = marker_presentation(base_marker, third)
      if key_pressed("left") {
        let previous = selection.identifier() - 1
        if previous < 1 { previous = 3 }
        selection.select!(previous)
      }
      if key_pressed("right") {
        let next = selection.identifier() + 1
        if next > 3 { next = 1 }
        selection.select!(next)
      }
      if focused_marker == false {
        if key_pressed("a") { camera_yaw = wrapped_angle(camera_yaw - 0.12) }
        if key_pressed("d") { camera_yaw = wrapped_angle(camera_yaw + 0.12) }
        if key_pressed("w") { camera_pitch = clamp_pitch(camera_pitch + 0.10) }
        if key_pressed("s") { camera_pitch = clamp_pitch(camera_pitch - 0.10) }
        camera_yaw = wrapped_angle(camera_yaw - orbit_delta_x() * 0.006)
        camera_pitch = clamp_pitch(camera_pitch + orbit_delta_y() * 0.006)
        camera_distance = zoom_distance(camera_distance, scroll_y())
        if key_pressed("q") {
          camera_distance = zoom_distance(camera_distance, -1.0)
        }
        if key_pressed("e") {
          camera_distance = zoom_distance(camera_distance, 1.0)
        }
      }
      let look_pitch_cosine = demo_cosine(camera_pitch)
      let look_forward_x = 0.0 - demo_cosine(camera_yaw) * look_pitch_cosine
      let look_forward_y = 0.0 - demo_sine(camera_yaw) * look_pitch_cosine
      let look_forward_z = 0.0 - demo_sine(camera_pitch)
      let viewport_x = 24.0
      let viewport_y = 76.0
      let viewport_width = width() - 48.0
      let viewport_height = height() - 116.0
      // Keep picking and painting on the same fresh presentation camera. The
      // accelerated demo Moon can move thousands of kilometres between frames;
      // using the previous camera here displaced the marker hit region even
      // though the following camera made its painted pin look stationary.
      if focusing == false {
        if focused_marker {
          orbit_target_x = sample(marker_value).x()
          orbit_target_y = sample(marker_value).y()
          orbit_target_z = sample(marker_value).z()
        } else {
        if focused_identifier > 0 {
          orbit_target_x = selected_target_x(focused_identifier, first, second, third)
          orbit_target_y = selected_target_y(focused_identifier, first, second, third)
          orbit_target_z = selected_target_z(focused_identifier, first, second, third)
        }
        }
        camera_x = orbit_target_x - look_forward_x * camera_distance
        camera_y = orbit_target_y - look_forward_y * camera_distance
        camera_z = orbit_target_z - look_forward_z * camera_distance
      }
      let marker_requested = false
      let marker_hovered = false
      let marker_fade_stage: Int64 = 3
      if marker_faces_camera(
           marker_value, third, camera_x, camera_y, camera_z) {
        let moon_depth = projected_depth(
          third, camera_x, camera_y, camera_z, camera_yaw, camera_pitch)
        let moon_radius =
          (sample(third).radius() / moon_depth) /
          0.577350269 * viewport_height / 2.0
        if moon_radius > 15.0 {
          let marker_icon_x = projected_x(
            marker_value, camera_x, camera_y, camera_z,
            camera_yaw, camera_pitch, camera_roll,
            viewport_x, viewport_width, viewport_height)
          let marker_icon_y = projected_y(
            marker_value, camera_x, camera_y, camera_z,
            camera_yaw, camera_pitch, camera_roll,
            viewport_y, viewport_height) - 68.0
          marker_hovered = pick_rectangle(
            pointer_x(), pointer_y(),
            marker_icon_x - 16.0, marker_icon_y - 18.0,
            176.0, 104.0)
        }
      }
      if pointer_pressed() {
        let click_x = pointer_x()
        let click_y = pointer_y()
        if pick_circle(click_x, click_y,
                       projected_x(first, camera_x, camera_y, camera_z,
                                   camera_yaw, camera_pitch, camera_roll,
                                   viewport_x, viewport_width, viewport_height),
                       projected_y(first, camera_x, camera_y, camera_z,
                                   camera_yaw, camera_pitch, camera_roll,
                                   viewport_y, viewport_height),
                       34.0) { selection.select!(1) }
        if pick_circle(click_x, click_y,
                       projected_x(second, camera_x, camera_y, camera_z,
                                   camera_yaw, camera_pitch, camera_roll,
                                   viewport_x, viewport_width, viewport_height),
                       projected_y(second, camera_x, camera_y, camera_z,
                                   camera_yaw, camera_pitch, camera_roll,
                                   viewport_y, viewport_height),
                       24.0) { selection.select!(2) }
        if pick_circle(click_x, click_y,
                       projected_x(third, camera_x, camera_y, camera_z,
                                   camera_yaw, camera_pitch, camera_roll,
                                   viewport_x, viewport_width, viewport_height),
                       projected_y(third, camera_x, camera_y, camera_z,
                                   camera_yaw, camera_pitch, camera_roll,
                                   viewport_y, viewport_height),
                       24.0) { selection.select!(3) }
        if marker_hovered {
          marker_requested = true
          selection.select!(3)
        }
      }
      if marker_requested {
        focus_start_x = orbit_target_x
        focus_start_y = orbit_target_y
        focus_start_z = orbit_target_z
        focus_start_distance = camera_distance
        focus_start_yaw = camera_yaw
        focus_start_pitch = camera_pitch
        focus_start_roll = camera_roll
        focus_target_x = local_target_x(base_marker, marker_value)
        focus_target_y = local_target_y(base_marker, marker_value)
        focus_target_z = local_target_z(base_marker, marker_value)
        focus_target_distance = LOCAL_VIEW_DISTANCE
        focus_duration = SURFACE_HANDOFF_DURATION_SECONDS
        focus_started = elapsed_seconds()
        focusing = true
        focus_source_identifier = focused_identifier
        focused_identifier = 0
        focused_marker = true
      } else {
      if key_pressed("enter") {
        if selection.identifier() != focused_identifier {
          focus_start_x = orbit_target_x
          focus_start_y = orbit_target_y
          focus_start_z = orbit_target_z
          focus_start_distance = camera_distance
          focus_target_x = selected_target_x(selection.identifier(), first, second, third)
          focus_target_y = selected_target_y(selection.identifier(), first, second, third)
          focus_target_z = selected_target_z(selection.identifier(), first, second, third)
          focus_target_distance = selected_view_distance(selection.identifier())
          focus_duration = FOCUS_DURATION_SECONDS
          if focus_target_distance > focus_start_distance {
            focus_duration = ANCESTOR_FOCUS_DURATION_SECONDS
          }
          if focus_target_distance > focus_start_distance * 1000.0 {
            focus_duration = LARGE_SCALE_FOCUS_DURATION_SECONDS
          }
          focus_started = elapsed_seconds()
          focusing = true
          focus_source_identifier = focused_identifier
          focused_identifier = selection.identifier()
          focused_marker = false
        }
      }
      }
      if focusing {
        let focus_elapsed = elapsed_seconds() - focus_started
        // The destination is a live presentation snapshot. Refresh it during
        // the ease so a moving body cannot leave behind the position captured
        // when Enter was pressed and then snap at transition completion.
        if focused_marker {
          focus_target_x = local_target_x(base_marker, marker_value)
          focus_target_y = local_target_y(base_marker, marker_value)
          focus_target_z = local_target_z(base_marker, marker_value)
        } else {
        if focused_identifier > 0 {
          focus_target_x = selected_target_x(focused_identifier, first, second, third)
          focus_target_y = selected_target_y(focused_identifier, first, second, third)
          focus_target_z = selected_target_z(focused_identifier, first, second, third)
        }
        }
        let base_progress = focus_progress(focus_elapsed, focus_duration)
        if focused_marker {
          camera_yaw = focus_scalar_at(
            focus_start_yaw, LOCAL_CAMERA_YAW, base_progress)
          camera_pitch = focus_scalar_at(
            focus_start_pitch, LOCAL_CAMERA_PITCH, base_progress)
          camera_roll = focus_scalar_at(
            focus_start_roll, LOCAL_CAMERA_ROLL, base_progress)
          if base_progress > 0.35 { marker_fade_stage = 2 }
          if base_progress > 0.58 { marker_fade_stage = 1 }
          if base_progress > 0.78 { marker_fade_stage = 0 }
        }
        let pan_progress = base_progress
        let zoom_progress = base_progress
        if focus_target_distance < focus_start_distance {
          // A family change may span hundreds of times in apparent scale.
          // Squaring the already-eased progress softens that initial scale
          // acceleration without introducing another phase boundary.
          zoom_progress = base_progress * base_progress
        }
        if focus_target_distance > focus_start_distance {
          // Ancestor focus derives pan from zoom below; there is no separate
          // pan phase or handoff that could read as two back-to-back focuses.
          zoom_progress = base_progress
        }
        camera_distance = focus_distance_at(
          focus_start_distance, focus_target_distance, zoom_progress)
        if focus_target_distance < focus_start_distance {
          // Couple translation to the solved zoom distance. The uncentered
          // fraction shrinks with distance, so the target's projected offset
          // cannot grow beyond its starting offset while both motions retain
          // zero endpoint velocity.
          pan_progress = 1.0 -
            (camera_distance / focus_start_distance) * (1.0 - base_progress)
        }
        if focus_target_distance > focus_start_distance {
          // Keep the descendant's projected motion on one smooth curve. At
          // close distance the ratio holds pan near its live source; as zoom
          // reveals context, pan grows continuously to the final framing. The
          // squared remaining fraction advances the middle sooner while giving
          // the final approach a visibly longer ease-out tail.
          let remaining_pan = 1.0 - base_progress
          let pan_curve = 1.0 - remaining_pan * remaining_pan
          pan_progress = pan_curve *
            camera_distance / focus_target_distance
        }
        let live_start_x = focus_start_x
        let live_start_y = focus_start_y
        let live_start_z = focus_start_z
        if focus_source_identifier > 0 {
          live_start_x = selected_target_x(
            focus_source_identifier, first, second, third)
          live_start_y = selected_target_y(
            focus_source_identifier, first, second, third)
          live_start_z = selected_target_z(
            focus_source_identifier, first, second, third)
        }
        orbit_target_x = focus_axis_at(live_start_x, focus_target_x, pan_progress)
        orbit_target_y = focus_axis_at(live_start_y, focus_target_y, pan_progress)
        orbit_target_z = focus_axis_at(live_start_z, focus_target_z, pan_progress)
        if focus_elapsed >= focus_duration {
          focusing = false
          if focused_marker { local_view = true }
        }
      }
      if focusing == false {
        if focused_marker {
          orbit_target_x = local_target_x(base_marker, marker_value)
          orbit_target_y = local_target_y(base_marker, marker_value)
          orbit_target_z = local_target_z(base_marker, marker_value)
        } else {
        if focused_identifier > 0 {
          orbit_target_x = selected_target_x(focused_identifier, first, second, third)
          orbit_target_y = selected_target_y(focused_identifier, first, second, third)
          orbit_target_z = selected_target_z(focused_identifier, first, second, third)
        }
        }
      }
      let render_pitch_cosine = demo_cosine(camera_pitch)
      let render_forward_x =
        0.0 - demo_cosine(camera_yaw) * render_pitch_cosine
      let render_forward_y =
        0.0 - demo_sine(camera_yaw) * render_pitch_cosine
      let render_forward_z = 0.0 - demo_sine(camera_pitch)
      camera_x = orbit_target_x - render_forward_x * camera_distance
      camera_y = orbit_target_y - render_forward_y * camera_distance
      camera_z = orbit_target_z - render_forward_z * camera_distance
      let surface_detail_active = local_view
      if focused_marker {
        if marker_fade_stage == 0 { surface_detail_active = true }
      }
      compose(camera_x, camera_y, camera_z, camera_yaw, camera_pitch,
              camera_roll,
              selection, first, second, third, base_marker, marker_value,
              focused_marker, marker_hovered, marker_fade_stage,
              surface_detail_active, focusing)
    }
  }
  close()
}
