module main

import SpatialRenderable from render.scene
import RenderSample from render.scene
import sample from render.scene
import relative_axis from render.scene
import perspective_axis from render.scene
import depth_visible from render.scene
import SurfaceLocationMarker from render.scene
import surface_location_visible from render.scene
import SelectionState from render.scene
import smooth_focus_axis from render.scene
import pick_circle from render.scene

class PresentationBody has SpatialRenderable {
  let identifier_value: Int64
  let x_value: Float64<meter>
  let label_value: String

  new(identifier: Int64, x: Float64<meter>, label: String) {
    self.identifier_value = identifier
    self.x_value = x
    self.label_value = label
  }

  fun render_identifier(): Int64 => self.identifier_value
  fun render_x(): Float64<meter> => self.x_value
  fun render_y(): Float64<meter> => 0.0 meter
  fun render_z(): Float64<meter> => 0.0 meter - 1000.0 kilometer
  fun render_radius(): Float64<meter> => 10.0 kilometer
  fun render_label(): String => self.label_value
}

fun main(): Int {
  let origin: Float64<meter> = 1000000000000.0 kilometer
  let body = PresentationBody(7, origin + 32.0 meter, "fixture")
  let frame_sample: RenderSample = sample(body)
  let relative = relative_axis(frame_sample.x(), origin)
  let projected = perspective_axis(relative, 1000.0 kilometer, 1.0, 960.0)
  if frame_sample.identifier() != 7 { return 1 }
  if relative != 32.0 meter { return 2 }
  if projected <= 480.0 { return 3 }
  if depth_visible(1000.0 kilometer, frame_sample.radius(),
                   1.0 meter, 2000.0 kilometer) == false { return 4 }
  let selection = SelectionState()
  selection.select!(frame_sample.identifier())
  if selection.is_selected(7) == false { return 5 }
  if pick_circle(10.0, 10.0, 10.0, 10.0, 4.0) == false { return 6 }
  let focus = smooth_focus_axis(origin, origin + 1000.0 kilometer, 1.0, 2.0)
  if focus != origin + 500.0 kilometer { return 7 }
  selection.clear!()
  if selection.has_selection() { return 8 }
  let marker = SurfaceLocationMarker(
    40, 3, 400, 0.25, 0.5, 12.0 meter, "SHACKLETON BASE")
  if marker.identifier() != 40 { return 9 }
  if marker.parent_identifier() != 3 { return 10 }
  if marker.destination_identifier() != 400 { return 11 }
  if marker.latitude_radians() != 0.25 { return 12 }
  if marker.longitude_radians() != 0.5 { return 13 }
  if marker.altitude() != 12.0 meter { return 14 }
  if marker.label() != "SHACKLETON BASE" { return 15 }
  if surface_location_visible(
       origin, origin, origin + 10.0 meter,
       origin, origin, origin,
       origin, origin, origin + 100.0 meter) == false { return 16 }
  if surface_location_visible(
       origin, origin, origin - 10.0 meter,
       origin, origin, origin,
       origin, origin, origin + 100.0 meter) { return 17 }
  return 0
}
