module ui

/// Open the SDL GPU UI host. Layout and composition remain in Sagan.
fun open(title: String, width: Int64, height: Int64): Bool =>
  __render_ui_open(title, width, height)

/// Poll native events. Returns false when the window should close.
fun poll(): Bool => __render_ui_poll()
fun close(): Void => __render_ui_close()

/// Current logical window dimensions, independent of drawable pixel density.
fun width(): Float64 => __render_ui_width()
fun height(): Float64 => __render_ui_height()

/// Begin a new handle-free logical draw list.
fun begin(): Void => __render_ui_begin()

/// Append a clipped logical rectangle.
fun fill(x: Float64, y: Float64, width: Float64, height: Float64,
         red: Int64, green: Int64, blue: Int64): Void =>
  __render_ui_fill(x, y, width, height, red, green, blue)

/// Append a clipped logical line segment. Physical paths remain the caller's
/// responsibility and should be projected into logical coordinates first.
fun line(first_x: Float64, first_y: Float64,
         second_x: Float64, second_y: Float64, thickness: Float64,
         clip_x: Float64, clip_y: Float64,
         clip_width: Float64, clip_height: Float64,
         red: Int64, green: Int64, blue: Int64): Void =>
  __render_ui_line(first_x, first_y, second_x, second_y, thickness,
                   clip_x, clip_y, clip_width, clip_height,
                   red, green, blue)

/// Shape and append deterministic bootstrap text at a logical position.
fun text(x: Float64, y: Float64, value: String, height: Float64,
         red: Int64, green: Int64, blue: Int64): Void =>
  __render_ui_text(x, y, value, height, red, green, blue)

/// Queue one indexed, depth-tested sphere. Positions and depth limits remain
/// unit typed until the native adapter rebases them around the camera. Logical
/// center offsets are presentation-only callouts and do not change body data.
fun mesh_sphere(viewport_x: Float64, viewport_y: Float64,
                viewport_width: Float64, viewport_height: Float64,
                camera_x: Float64<meter>, camera_y: Float64<meter>,
                camera_z: Float64<meter>, forward_x: Float64,
                forward_y: Float64, forward_z: Float64,
                up_x: Float64, up_y: Float64, up_z: Float64,
                field_of_view: Float64, near_distance: Float64<meter>,
                far_distance: Float64<meter>, body_x: Float64<meter>,
                body_y: Float64<meter>, body_z: Float64<meter>,
                radius: Float64<meter>, appearance: Int64,
                minimum_radius: Float64, center_offset_x: Float64,
                center_offset_y: Float64, selected: Bool): Void =>
  __render_ui_mesh_sphere(
    viewport_x, viewport_y, viewport_width, viewport_height,
    camera_x, camera_y, camera_z, forward_x, forward_y, forward_z,
    up_x, up_y, up_z, field_of_view, near_distance, far_distance,
    body_x, body_y, body_z, radius, appearance, minimum_radius,
    center_offset_x, center_offset_y, selected)

/// Submit the logical draw list to the private GPU backend.
fun present(): Void => __render_ui_present()

/// Consume one named key press. The current host recognizes tab, shift-tab,
/// enter, space, p, f, r, escape, and the four arrow directions.
fun key_pressed(key: String): Bool => __render_ui_key_pressed(key)
fun pointer_pressed(): Bool => __render_ui_pointer_pressed()
fun pointer_released(): Bool => __render_ui_pointer_released()
fun pointer_x(): Float64 => __render_ui_pointer_x()
fun pointer_y(): Float64 => __render_ui_pointer_y()

/// Consume accumulated right-button drag motion since the previous call.
/// These logical-pixel deltas let applications implement target-centered
/// orbit cameras without exposing native SDL events.
fun orbit_delta_x(): Float64 => __render_ui_orbit_delta_x()
fun orbit_delta_y(): Float64 => __render_ui_orbit_delta_y()

/// Consume accumulated vertical wheel movement. Positive values zoom inward
/// by convention; applications retain control of physical distance limits.
fun scroll_y(): Float64 => __render_ui_scroll_y()

/// Monotonic seconds since the UI host opened.
fun elapsed_seconds(): Float64 => __render_elapsed_seconds()

export open
export poll
export close
export width
export height
export begin
export fill
export line
export text
export mesh_sphere
export present
export key_pressed
export pointer_pressed
export pointer_released
export pointer_x
export pointer_y
export orbit_delta_x
export orbit_delta_y
export scroll_y
export elapsed_seconds
