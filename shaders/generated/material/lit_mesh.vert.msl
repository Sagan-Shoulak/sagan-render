#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_CameraUniform
{
    float4x4 model_view_projection;
    float4x4 normal_matrix;
};

struct type_MaterialUniform
{
    float4 base_color_linear;
    float4 emissive_linear_and_roughness;
};

struct type_LightingUniform
{
    float4 ambient_linear;
    float4 direction_to_light_and_intensity;
    float4 light_color_linear;
};

struct VSMain_out
{
    float3 out_var_TEXCOORD0 [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct VSMain_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float3 in_var_TEXCOORD1 [[attribute(1)]];
};

vertex VSMain_out VSMain(VSMain_in in [[stage_in]], constant type_CameraUniform& CameraUniform [[buffer(0)]])
{
    VSMain_out out = {};
    out.gl_Position = CameraUniform.model_view_projection * float4(in.in_var_TEXCOORD0, 1.0);
    out.out_var_TEXCOORD0 = fast::normalize((CameraUniform.normal_matrix * float4(in.in_var_TEXCOORD1, 0.0)).xyz);
    return out;
}

