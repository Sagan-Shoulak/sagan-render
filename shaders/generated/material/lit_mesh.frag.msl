#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_CameraUniform
{
    float4x4 model_view_projection;
    float4x4 normal_matrix;
};

struct type_MaterialUniform
{
    float4 base_color_linear;
    float4 emissive_linear_and_roughness;
};

struct type_LightingUniform
{
    float4 ambient_linear;
    float4 direction_to_light_and_intensity;
    float4 light_color_linear;
};

struct PSMain_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct PSMain_in
{
    float3 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment PSMain_out PSMain(PSMain_in in [[stage_in]], constant type_MaterialUniform& MaterialUniform [[buffer(0)]], constant type_LightingUniform& LightingUniform [[buffer(1)]])
{
    PSMain_out out = {};
    out.out_var_SV_Target0 = float4((MaterialUniform.base_color_linear.xyz * (LightingUniform.ambient_linear.xyz + (LightingUniform.light_color_linear.xyz * (precise::max(0.0, dot(fast::normalize(in.in_var_TEXCOORD0), LightingUniform.direction_to_light_and_intensity.xyz)) * LightingUniform.direction_to_light_and_intensity.w)))) + MaterialUniform.emissive_linear_and_roughness.xyz, MaterialUniform.base_color_linear.w);
    return out;
}

