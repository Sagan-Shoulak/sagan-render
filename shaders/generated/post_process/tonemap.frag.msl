#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_PostProcessUniform
{
    float4 exposure_and_inverse_gamma;
};

struct PSMain_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct PSMain_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment PSMain_out PSMain(PSMain_in in [[stage_in]], constant type_PostProcessUniform& PostProcessUniform [[buffer(0)]], texture2d<float> scene_color [[texture(0)]], sampler scene_sampler [[sampler(0)]])
{
    PSMain_out out = {};
    out.out_var_SV_Target0 = float4(powr(float3(1.0) - exp((-precise::max(scene_color.sample(scene_sampler, in.in_var_TEXCOORD0).xyz, float3(0.0))) * precise::max(PostProcessUniform.exposure_and_inverse_gamma.x, 0.0)), float3(precise::max(PostProcessUniform.exposure_and_inverse_gamma.y, 9.9999997473787516355514526367188e-05))), 1.0);
    return out;
}

